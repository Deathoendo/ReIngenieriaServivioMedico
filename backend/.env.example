# ---------------------------------------------------------------------------
# Servicio Médico API — configuración de ejemplo
# Copia este archivo a `.env` y ajusta los valores. NUNCA subas el .env real.
# ---------------------------------------------------------------------------

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# Orígenes permitidos, separados por coma. Usa * solo en desarrollo.
CORS_ORIGIN=http://localhost:4200

# ---------------------------------------------------------------------------
# AUTENTICACIÓN
# ---------------------------------------------------------------------------
# Proveedor de identidad:
#   local -> valida contra la tabla `usuarios` (hash bcrypt). Ideal para demo y desarrollo.
#   ldap  -> bind real contra un Directorio Activo / OpenLDAP corporativo.
AUTH_PROVIDER=local

# --- Sesión (JWT) ---
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m

# --- Directorio Activo (solo si AUTH_PROVIDER=ldap) ---
# LDAP_URL=ldaps://dc01.meridiano.local:636
# LDAP_BASE=DC=meridiano,DC=local
# LDAP_BIND_DN=CN=svc-portal,OU=Servicios,DC=meridiano,DC=local
# LDAP_BIND_PW=secreto-del-usuario-de-servicio
# LDAP_SEARCH_FILTER_BY_MAIL=(&(objectClass=user)(mail={0}))
# LDAP_TIMEOUT_MS=5000
# TSL_REJECT_UNAUTHORIZED=true

# Grupos del directorio autorizados a entrar al portal (DN completo).
# GROUP_ADMIN=CN=GRP_MER_SISTEMAS_ADMIN,OU=Grupos,DC=meridiano,DC=local
# GROUP_ASEGURAMIENTO=CN=GRP_MER_MEDICINA_ASEGURAMIENTO,OU=Grupos,DC=meridiano,DC=local
# GROUP_OPERACIONES=CN=GRP_MER_MEDICINA_OPERACIONES,OU=Grupos,DC=meridiano,DC=local
# GROUP_SALUD_LABORAL=CN=GRP_MER_SALUD_LABORAL,OU=Grupos,DC=meridiano,DC=local
# GROUP_COORD_MEDICA=CN=GRP_MER_COORD_MEDICA,OU=Grupos,DC=meridiano,DC=local

# ---------------------------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=portalmed
MYSQL_PW=cambia-esta-contrasena
MYSQL_DB=servicio_medico
MYSQL_CONN_LIMIT=10
